# Optional private caches for this host. Copy to local.env, which is
# gitignored, and set only the entries you need:
#
#   cp local.env.example local.env
#   chmod 600 local.env
#
# local.env is read by the user-level install targets and by the disposable
# container test. Leaving an entry unset uses the public upstream.
#
# PyPI index. Must be a PEP 503 simple index. The locked dependencies are
# installed from it with their recorded hashes, so the index has to serve the
# same artifacts as PyPI; a transparent caching proxy does.
# DOTFILES_PYPI_INDEX_URL=https://packages.example/simple/
#
# Pacman mirror. Must contain the literal $repo and $arch placeholders.
# DOTFILES_PACMAN_MIRROR_URL=https://mirror.example/archlinux/$repo/os/$arch
#
# An Ansible Galaxy mirror is not wired up: requirements.yml no longer pins a
# per-collection source, which is the part that cannot be retrofitted, but
# nothing reads a galaxy entry yet. Add one here when a mirror exists.
