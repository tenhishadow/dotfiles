# Host-specific configuration must precede general defaults because OpenSSH
# uses the first value obtained for each option.
Include config.d/*
Include conf.d/*

# Owner-selected defaults; preserve this policy per dotfiles/AGENTS.md.
# See ssh_config(5).
Host *
  CheckHostIP            no
  Compression            yes
  ForwardAgent           yes
  ForwardX11             no
  HashKnownHosts         no
  KbdInteractiveAuthentication no
  PasswordAuthentication no
  ServerAliveInterval    30
  ServerAliveCountMax    3
  StrictHostKeyChecking  no
  TCPKeepAlive           yes
  UserKnownHostsFile     /dev/null
  # UpdateHostKeys is deliberately absent, not set to no: OpenSSH already
  # defaults it to no once UserKnownHostsFile is overridden, and setting it
  # explicitly defeated that. With it on, a caller that supplies its own
  # known_hosts file on the command line -- Proxmox does, pointing at
  # /etc/pve/nodes/<node>/ssh_known_hosts -- made ssh try to rewrite that
  # file. pmxcfs cannot hardlink, so hostfile_replace_entries failed with
  # EPERM on every cluster hop. Keeping no host keys and rewriting host key
  # files are contradictory requests; this policy keeps none.
