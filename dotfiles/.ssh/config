# Host-specific configuration must precede general defaults because OpenSSH
# uses the first value obtained for each option.
Include config.d/*
Include conf.d/*

# Secure defaults for hosts without an explicit override.
# See ssh_config(5).
Host *
  CheckHostIP            no
  Compression            no
  ForwardAgent           no
  ForwardX11             no
  HashKnownHosts         yes
  KbdInteractiveAuthentication no
  PasswordAuthentication no
  ServerAliveInterval    30
  ServerAliveCountMax    3
  StrictHostKeyChecking  ask
  TCPKeepAlive           yes
  UpdateHostKeys         yes
