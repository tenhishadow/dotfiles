# Host-specific configuration must precede general defaults because OpenSSH
# uses the first value obtained for each option.
Include config.d/*
Include conf.d/*

# Owner-selected defaults; preserve this policy per dotfiles/AGENTS.md.
# See ssh_config(5).
Host *
  CheckHostIP            no
  Compression            yes
  ForwardAgent           yes
  ForwardX11             no
  HashKnownHosts         no
  KbdInteractiveAuthentication no
  PasswordAuthentication no
  ServerAliveInterval    30
  ServerAliveCountMax    3
  StrictHostKeyChecking  no
  TCPKeepAlive           yes
  UpdateHostKeys         yes
  UserKnownHostsFile     /dev/null
