{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "enabledManagers": ["ansible-galaxy", "github-actions", "npm", "pep621", "pre-commit", "custom.regex"],
  "ignorePaths": [".test/**"],
  "ansible-galaxy": {
    "enabled": true
  },
  "github-actions": {
    "enabled": true
  },
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the slim SUPERLINTER_IMAGE_TAG variable in Taskfile.yml.",
      "managerFilePatterns": ["/^Taskfile\\.yml$/"],
      "matchStrings": ["SUPERLINTER_IMAGE_TAG: \"slim-(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "ghcr.io/super-linter/super-linter",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update the pinned pinact release used by deps-upgrade.",
      "managerFilePatterns": ["/^Taskfile\\.yml$/"],
      "matchStrings": ["PINACT_VERSION: \"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "suzuki-shunsuke/pinact",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Report exact CI bootstrap versions maintained by the weekly updater.",
      "managerFilePatterns": ["/^\\.github/(actions|workflows)/.+\\.ya?ml$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>github-releases) depName=(?<depName>[^\\s]+)\\s+version: \"?(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"],
      "versioningTemplate": "semver"
    }
  ],
  "enabled": false,
  "packageRules": [
    {
      "matchManagers": ["ansible-galaxy"],
      "registryUrls": ["https://galaxy.ansible.com/api/"]
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["suzuki-shunsuke/pinact"],
      "allowedVersions": "/^v5\\./"
    }
  ]
}
