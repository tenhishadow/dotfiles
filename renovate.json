{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", "helpers:pinGitHubActionDigests"],
  "enabledManagers": ["ansible-galaxy", "github-actions", "npm", "pep621", "pre-commit", "custom.regex"],
  "ignorePaths": [".test/**"],
  "labels": ["dependencies"],
  "semanticCommits": "enabled",
  "semanticCommitType": "deps",
  "semanticCommitScope": null,
  "lockFileMaintenance": {
    "enabled": true
  },
  "ansible-galaxy": {
    "enabled": true
  },
  "github-actions": {
    "enabled": true
  },
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the slim SUPERLINTER_IMAGE_TAG variable in Taskfile.yml.",
      "managerFilePatterns": ["/^Taskfile\\.yml$/"],
      "matchStrings": ["SUPERLINTER_IMAGE_TAG: \"slim-(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "ghcr.io/super-linter/super-linter",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update the pinned pinact release used by deps-upgrade.",
      "managerFilePatterns": ["/^Taskfile\\.yml$/"],
      "matchStrings": ["PINACT_VERSION: \"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "suzuki-shunsuke/pinact",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Refresh the taskfile.uv reusable workflow pin from its tracked branch.",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "uses:\\s+tenhishadow/github_actions_templates/\\.github/workflows/taskfile\\.uv\\.yaml@(?<currentDigest>[a-f0-9]{40})\\s+#\\s+renovate:\\s+branch=(?<currentValue>[A-Za-z0-9._/-]+)"
      ],
      "depNameTemplate": "tenhishadow/github_actions_templates",
      "packageNameTemplate": "https://github.com/tenhishadow/github_actions_templates.git",
      "datasourceTemplate": "git-refs",
      "versioningTemplate": "exact"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["suzuki-shunsuke/pinact"],
      "allowedVersions": "/^v4\\./"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "addLabels": ["ci"]
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepNames": ["tenhishadow/github_actions_templates"],
      "enabled": false
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["tenhishadow/github_actions_templates"],
      "groupName": "github actions",
      "addLabels": ["ci"]
    },
    {
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks"
    },
    {
      "matchManagers": ["ansible-galaxy"],
      "groupName": "ansible collections",
      "addLabels": ["ansible"],
      "registryUrls": ["https://galaxy.ansible.com/api/"]
    },
    {
      "matchManagers": ["pep621"],
      "groupName": "python toolchain"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["dotfiles/.local/share/codex-*/**"],
      "groupName": "Codex CLI and MCP packages"
    },
    {
      "matchDepNames": ["ghcr.io/super-linter/super-linter", "super-linter/super-linter"],
      "groupName": "super-linter",
      "addLabels": ["ci"]
    }
  ]
}
